#version 450

// out = softmax(scale * x) over each row of a [rows, cols] f32 matrix. One
// workgroup per row (striding over rows beyond the dispatch), with the max and
// the sum reduced through shared memory. Subtracting the row max keeps exp in
// range; -inf entries (attention masks) come out as exactly 0.
//
// With CAUSAL, rows are attention scores [heads * q_len, cols] and row r only
// sees columns c <= (r % q_len) + offset: each query attends to keys at or
// before its own position, and with a window only the last window of those
// (c > position - window). The rest come out as exactly 0.
//
// With softcap > 0, each scale * x is capped to softcap * tanh(. / softcap)
// first, as Gemma 2 caps attention scores.

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const bool CAUSAL = false;

layout(std430, set = 0, binding = 0) readonly buffer X {
    float x[];
};
layout(std430, set = 0, binding = 1) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint rows;
    uint cols;
    float scale;
    uint q_len;   // CAUSAL only
    uint offset;  // CAUSAL only: position of query 0 among the keys
    uint window;  // CAUSAL only: if not 0, the keys each query sees at most
    float softcap;  // if > 0, scores are capped to +-softcap
} params;

// Element i scaled, and capped. tanh is clamped to +-10, where it is +-1 in
// f32 already: some drivers compute it from exp, which overflows.
float score(uint i) {
    const float s = params.scale * x[i];
    return params.softcap > 0.0 ? params.softcap * tanh(clamp(s / params.softcap, -10.0, 10.0))
                                : s;
}

shared float scratch[gl_WorkGroupSize.x];

// Halving tree that works for any workgroup width, not just powers of two.
float reduce_max(float v) {
    const uint tid = gl_LocalInvocationID.x;
    scratch[tid] = v;
    barrier();
    for (uint n = gl_WorkGroupSize.x; n > 1;) {
        const uint half_ = (n + 1) / 2;
        if (tid < n - half_) scratch[tid] = max(scratch[tid], scratch[tid + half_]);
        barrier();
        n = half_;
    }
    const float r = scratch[0];
    barrier();  // before scratch is reused
    return r;
}

float reduce_sum(float v) {
    const uint tid = gl_LocalInvocationID.x;
    scratch[tid] = v;
    barrier();
    for (uint n = gl_WorkGroupSize.x; n > 1;) {
        const uint half_ = (n + 1) / 2;
        if (tid < n - half_) scratch[tid] += scratch[tid + half_];
        barrier();
        n = half_;
    }
    const float r = scratch[0];
    barrier();
    return r;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint width = gl_WorkGroupSize.x;
    const float neg_inf = uintBitsToFloat(0xFF800000u);

    for (uint row = gl_WorkGroupID.x; row < params.rows; row += gl_NumWorkGroups.x) {
        const uint base = row * params.cols;
        const uint visible =
            CAUSAL ? min(params.cols, row % params.q_len + params.offset + 1) : params.cols;
        const uint first =
            CAUSAL && params.window != 0 && visible > params.window ? visible - params.window : 0;

        float m = neg_inf;
        for (uint c = first + tid; c < visible; c += width) m = max(m, score(base + c));
        m = reduce_max(m);

        float s = 0.0;
        for (uint c = first + tid; c < visible; c += width) s += exp(score(base + c) - m);
        s = reduce_sum(s);

        const float inv = 1.0 / s;
        for (uint c = tid; c < params.cols; c += width) {
            out_[base + c] =
                c >= first && c < visible ? exp(score(base + c) - m) * inv : 0.0;
        }
    }
}
