#version 450

// Fills a buffer of 32-bit words with one bit pattern (0 for zeros(), or the
// bits of any float/int). Used by Tensor::zeros and as the first kernel the
// build pipeline compiles.

// Workgroup width is specialization constant 0, chosen by the host from
// maxComputeWorkGroupSize: the spec only guarantees 128.
layout(local_size_x_id = 0) in;

layout(std430, set = 0, binding = 0) writeonly buffer Dst {
    uint words[];
} dst;

layout(push_constant) uniform Params {
    uint count;
    uint value;
} params;

void main() {
    // Grid-stride loop: correct for any dispatch size, so the host can cap the
    // workgroup count at maxComputeWorkGroupCount instead of launching count/width.
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        dst.words[i] = params.value;
    }
}
