#version 450

// out[i] = a[i] OP b[i] over f32 tensors of the same shape. OP is
// specialization constant 1, so each op compiles to its own branch-free pipeline.

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint OP = 0;  // 0 add, 1 sub, 2 mul, 3 div

layout(std430, set = 0, binding = 0) readonly buffer A {
    float a[];
};
layout(std430, set = 0, binding = 1) readonly buffer B {
    float b[];
};
layout(std430, set = 0, binding = 2) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        const float x = a[i];
        const float y = b[i];
        float r;
        if (OP == 0) {
            r = x + y;
        } else if (OP == 1) {
            r = x - y;
        } else if (OP == 2) {
            r = x * y;
        } else {
            r = x / y;
        }
        out_[i] = r;
    }
}
