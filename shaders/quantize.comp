#version 450
#extension GL_GOOGLE_include_directive : require

// Quantizes a [rows, cols] matrix (f32, f16 or bf16: SRC_TYPE) to a format of
// llama.cpp (QUANT). Each block of 32 consecutive values along a row gets a
// scale d and values round(x / d):
// - Q8_0: d = max |x| / 127, values in [-127, 127], four to a word.
// - Q4_0: d = m / -8 for m the value of largest magnitude, values clamped to
//   [-8, 7] and stored plus 8, eight four-bit values to a word (in the order
//   of shaders/include/halves.glsl).
// - Q4_1: d = (max - min) / 15 and offset min, values round((x - min) / d)
//   from 0 to 15, packed as Q4_0's; (d, min) pairs in scales.
// An all-zero block gets scale 0 and zeros. One invocation per block; with
// cols a multiple of 32, block b is elements 32b..32b+31.

#include "include/halves.glsl"

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint SRC_TYPE = TYPE_F32;
layout(constant_id = 2) const uint QUANT = TYPE_Q8;

layout(std430, set = 0, binding = 0) readonly buffer X {
    float x[];
};
layout(std430, set = 0, binding = 0) readonly buffer XHalves {
    uint x_halves[];
};
layout(std430, set = 0, binding = 1) writeonly buffer Q {
    uint q[];  // 8 (Q8_0) or 4 (Q4_0) words per block
};
layout(std430, set = 0, binding = 2) writeonly buffer S {
    float scales[];
};

layout(push_constant) uniform Params {
    uint blocks;
} params;

float load(uint e) {
    return SRC_TYPE == TYPE_F32 ? x[e] : half_element(x_halves[e / 2], e, SRC_TYPE);
}

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint b = gl_GlobalInvocationID.x; b < params.blocks; b += stride) {
        const uint base = b * Q8_BLOCK;
        if (QUANT == TYPE_Q4_1) {
            float lo = load(base), hi = lo;
            for (uint i = 1; i < Q4_BLOCK; ++i) {
                const float v = load(base + i);
                lo = min(lo, v);
                hi = max(hi, v);
            }
            const float d = (hi - lo) / 15.0;
            const float inv = d > 0.0 ? 1.0 / d : 0.0;
            for (uint w = 0; w < Q4_BLOCK / 8; ++w) {
                uint word = 0;
                for (uint j = 0; j < 8; ++j) {
                    const float code = clamp(roundEven((load(base + 8 * w + j) - lo) * inv), 0.0, 15.0);
                    word |= uint(code) << q4_shift(j);
                }
                q[b * (Q4_BLOCK / 8) + w] = word;
            }
            scales[2 * b] = d;
            scales[2 * b + 1] = lo;
            continue;
        }
        if (QUANT == TYPE_Q4) {
            float m = 0.0;  // the first value of largest magnitude, as llama.cpp picks
            for (uint i = 0; i < Q4_BLOCK; ++i) {
                const float v = load(base + i);
                if (abs(v) > abs(m)) m = v;
            }
            const float inv = m != 0.0 ? -8.0 / m : 0.0;
            for (uint w = 0; w < Q4_BLOCK / 8; ++w) {
                uint word = 0;
                for (uint j = 0; j < 8; ++j) {
                    const int v = int(clamp(roundEven(load(base + 8 * w + j) * inv), -8.0, 7.0));
                    word |= uint(v + 8) << q4_shift(j);
                }
                q[b * (Q4_BLOCK / 8) + w] = word;
            }
            scales[b] = m / -8.0;
            continue;
        }
        float absmax = 0.0;
        for (uint i = 0; i < Q8_BLOCK; ++i) absmax = max(absmax, abs(load(base + i)));
        const float scale = absmax / 127.0;
        const float inv = absmax > 0.0 ? 127.0 / absmax : 0.0;
        for (uint w = 0; w < Q8_BLOCK / 4; ++w) {
            uint word = 0;
            for (uint j = 0; j < 4; ++j) {
                const int v = int(clamp(roundEven(load(base + 4 * w + j) * inv), -127.0, 127.0));
                word |= (uint(v) & 0xFFu) << (8 * j);
            }
            q[b * (Q8_BLOCK / 4) + w] = word;
        }
        scales[b] = scale;
    }
}
