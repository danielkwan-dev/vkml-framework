#version 450
#extension GL_GOOGLE_include_directive : require

// c[z] = a[z] * b[z / b_group]^T for M <= MAX_M rows: a [M, K], b [N, K] (a
// weight matrix, or keys), c [M, N]. Row-major; a and c are f32, b is f32,
// f16, bf16 or Q8_0 (B_TYPE, scales in binding 3): smaller weights mean fewer
// bytes read per decoding step. This is
// matmul_transposed for the matrix-vector shapes of decoding, where the tiled
// kernel leaves most invocations idle and is far from memory bandwidth.
//
// A workgroup of 128 invocations computes ROWS outputs for every row of a:
// each output gets 128 / ROWS lanes that stride along K together, so
// neighbouring lanes read neighbouring addresses, each lane keeping one sum
// per row so b is read once, and a shared-memory tree sums the lanes.
// Workgroup z is the batch. MAX_M, the number of sums each lane keeps, is set
// per call to the smallest power of two covering M: more sums than rows would
// cost registers for nothing, which slows the one-row case decoding uses.

#include "include/halves.glsl"

layout(local_size_x = 128) in;
layout(constant_id = 0) const uint ROWS = 4;  // outputs per workgroup; a power of two
layout(constant_id = 1) const uint B_TYPE = TYPE_F32;
layout(constant_id = 2) const uint MAX_M = 1;  // 1, 2, 4 or 8 (kGemvMaxRows) and at least M

layout(std430, set = 0, binding = 0) readonly buffer A {
    float a[];
};
layout(std430, set = 0, binding = 0) readonly buffer A4 {
    vec4 a4[];
};
layout(std430, set = 0, binding = 1) readonly buffer B {
    float b[];
};
layout(std430, set = 0, binding = 1) readonly buffer B4 {
    vec4 b4[];
};
layout(std430, set = 0, binding = 1) readonly buffer BHalves {
    uint b_halves[];  // two 16-bit values per word
};
layout(std430, set = 0, binding = 1) readonly buffer BHalves4 {
    uvec2 b_halves4[];  // four 16-bit values
};
layout(std430, set = 0, binding = 2) writeonly buffer C {
    float c[];
};
layout(std430, set = 0, binding = 3) readonly buffer BScales {
    float b_scales[];  // Q8_0 block scales; bound to a dummy for other types
};

// b's four elements starting at row_start + 4 * i (row_start a multiple of 4).
vec4 load_b4(uint row_start, uint i) {
    if (B_TYPE == TYPE_F32) return b4[row_start / 4 + i];
    if (B_TYPE == TYPE_Q8) {
        return q8_vec4(b_halves[row_start / 4 + i], b_scales[(row_start + 4 * i) / Q8_BLOCK]);
    }
    return half_vec4(b_halves4[row_start / 4 + i], B_TYPE);
}

float load_b(uint j) {
    if (B_TYPE == TYPE_F32) return b[j];
    if (B_TYPE == TYPE_Q8) return q8_byte(b_halves[j / 4], j) * b_scales[j / Q8_BLOCK];
    return half_element(b_halves[j / 2], j, B_TYPE);
}

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
    uint b_stride;  // elements between batches of b
    uint b_group;   // batches of a per batch of b
} params;

shared float partial[MAX_M * 128];

void main() {
    const uint lanes = 128 / ROWS;
    const uint tid = gl_LocalInvocationID.x;
    const uint lane = tid % lanes;
    const uint n = gl_WorkGroupID.x * ROWS + tid / lanes;
    const uint z = gl_WorkGroupID.z;
    const uint M = params.M;

    const uint a_base = z * M * params.K;
    const uint b_row = (z / params.b_group) * params.b_stride + n * params.K;

    float acc[MAX_M];
    for (uint r = 0; r < MAX_M; ++r) acc[r] = 0.0;
    if (n < params.N) {
        if ((params.K & 3u) == 0) {
            // Every row then starts on a 4-element boundary: K, and so b_stride,
            // are multiples of 4, so vec4 and 16-bit uvec2 loads line up.
            const uint k4 = params.K / 4;
            if (B_TYPE == TYPE_Q8) {
                // One word (four values) per lane per load, as for other
                // types, so neighbouring lanes read neighbouring addresses of
                // both operands; but four loads per iteration, lanes apart,
                // since one outstanding 4-byte load per lane cannot keep up
                // with memory. (One 16-byte load per lane instead ran at a
                // third of the speed: its reads of a were scattered.)
                uint i = lane;
                for (; i + 3 * lanes < k4; i += 4 * lanes) {
                    uint words[4];
                    float scales[4];
                    for (uint u = 0; u < 4; ++u) {
                        const uint idx = i + u * lanes;
                        words[u] = b_halves[b_row / 4 + idx];
                        scales[u] = b_scales[(b_row + 4 * idx) / Q8_BLOCK];
                    }
                    for (uint u = 0; u < 4; ++u) {
                        const vec4 w = q8_vec4(words[u], scales[u]);
                        for (uint r = 0; r < MAX_M; ++r) {
                            if (r < M) acc[r] += dot(a4[a_base / 4 + r * k4 + i + u * lanes], w);
                        }
                    }
                }
                for (; i < k4; i += lanes) {
                    const vec4 w = load_b4(b_row, i);
                    for (uint r = 0; r < MAX_M; ++r) {
                        if (r < M) acc[r] += dot(a4[a_base / 4 + r * k4 + i], w);
                    }
                }
            } else {
                for (uint i = lane; i < k4; i += lanes) {
                    const vec4 w = load_b4(b_row, i);
                    for (uint r = 0; r < MAX_M; ++r) {
                        if (r < M) acc[r] += dot(a4[a_base / 4 + r * k4 + i], w);
                    }
                }
            }
        } else {
            for (uint k = lane; k < params.K; k += lanes) {
                const float w = load_b(b_row + k);
                for (uint r = 0; r < MAX_M; ++r) {
                    if (r < M) acc[r] += a[a_base + r * params.K + k] * w;
                }
            }
        }
    }

    // Loops run to the constant MAX_M so they unroll and acc stays in registers.
    for (uint r = 0; r < MAX_M; ++r) partial[r * 128 + tid] = acc[r];
    barrier();
    for (uint s = lanes / 2; s > 0; s /= 2) {
        if (lane < s) {
            for (uint r = 0; r < M; ++r) partial[r * 128 + tid] += partial[r * 128 + tid + s];
        }
        barrier();
    }
    if (lane == 0 && n < params.N) {
        for (uint r = 0; r < M; ++r) c[(z * M + r) * params.N + n] = partial[r * 128 + tid];
    }
}
