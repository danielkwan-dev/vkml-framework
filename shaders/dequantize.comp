#version 450
#extension GL_GOOGLE_include_directive : require

// out[e] = value e of a Q8_0, Q4_0 or Q4_1 matrix (QUANT; see quantize.comp):
// its code times its block's scale, plus the block's offset for Q4_1.

#include "include/halves.glsl"

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint QUANT = TYPE_Q8;

layout(std430, set = 0, binding = 0) readonly buffer Q {
    uint q[];
};
layout(std430, set = 0, binding = 1) readonly buffer S {
    float scales[];
};
layout(std430, set = 0, binding = 1) readonly buffer ScaleHalves {
    uint scales_halves[];  // the same, as f16 (SCALE_TYPE)
};
layout(constant_id = 2) const uint SCALE_TYPE = TYPE_F32;  // the scales' type: f32 or f16

// Scale (or Q4_1 offset) i, widened from f16 by hand: subnormal scales,
// of blocks of tiny weights, must not flush to zero.
float scale(uint i) {
    return SCALE_TYPE == TYPE_F16 ? half_element(scales_halves[i / 2], i, TYPE_F16)
                                  : scales[i];
}
layout(std430, set = 0, binding = 2) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint count;
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint e = gl_GlobalInvocationID.x; e < params.count; e += stride) {
        if (QUANT == TYPE_Q4_1) {
            const uint block = e / Q4_BLOCK;
            out_[e] = q4_code(q[e / 8], e) * scale(2 * block) + scale(2 * block + 1);
        } else {
            out_[e] = QUANT == TYPE_Q4 ? q4_nibble(q[e / 8], e) * scale(e / Q4_BLOCK)
                                       : q8_byte(q[e / 4], e) * scale(e / Q8_BLOCK);
        }
    }
}
