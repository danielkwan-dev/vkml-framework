#version 450

// out[i, :] = table[ids[i], :] for a [vocab, dim] f32 table and i32 ids.
// Ids outside [0, vocab) give zero rows: a kernel cannot report errors, and
// reading out of bounds is undefined.

layout(local_size_x_id = 0) in;

layout(std430, set = 0, binding = 0) readonly buffer Table {
    float table[];
};
layout(std430, set = 0, binding = 1) readonly buffer Ids {
    int ids[];
};
layout(std430, set = 0, binding = 2) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint count;  // ids * dim
    uint dim;
    uint vocab;
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        const int id = ids[i / params.dim];
        const uint col = i % params.dim;
        out_[i] = (id >= 0 && uint(id) < params.vocab) ? table[uint(id) * params.dim + col] : 0.0;
    }
}
