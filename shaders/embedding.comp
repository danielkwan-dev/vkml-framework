#version 450
#extension GL_GOOGLE_include_directive : require

// out[i, :] = table[ids[i], :] for a [vocab, dim] table of f32, f16 or bf16
// (TABLE_TYPE) and i32 ids, widened to f32.
// Ids outside [0, vocab) give zero rows: a kernel cannot report errors, and
// reading out of bounds is undefined.

#include "include/halves.glsl"

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint TABLE_TYPE = TYPE_F32;

layout(std430, set = 0, binding = 0) readonly buffer Table {
    float table[];
};
layout(std430, set = 0, binding = 0) readonly buffer TableHalves {
    uint table_halves[];  // two 16-bit values per word
};

float load_table(uint i) {
    return TABLE_TYPE == TYPE_F32 ? table[i] : half_element(table_halves[i / 2], i, TABLE_TYPE);
}

layout(std430, set = 0, binding = 1) readonly buffer Ids {
    int ids[];
};
layout(std430, set = 0, binding = 2) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint count;  // ids * dim
    uint dim;
    uint vocab;
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        const int id = ids[i / params.dim];
        const uint col = i % params.dim;
        out_[i] = (id >= 0 && uint(id) < params.vocab) ? load_table(uint(id) * params.dim + col) : 0.0;
    }
}
