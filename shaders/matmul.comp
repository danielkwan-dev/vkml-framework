#version 450
#extension GL_GOOGLE_include_directive : require

// c[z] = a[z] * b[z / b_group] for z in 0..batches, with a [M, K], c [M, N]
// and b either [K, N] or, when B_TRANSPOSED, [N, K]. Row-major; a and c are
// f32, b is f32, f16 or bf16 (B_TYPE), widened as it is loaded. With
// b_stride 0 every batch shares one b; b_group > 1 lets consecutive batches of
// a share one of b, as query heads share a KV head in grouped-query attention.
//
// Each TILE x TILE workgroup computes one TILE x TILE block of c, one element
// per invocation, stepping through K a tile at a time with both input tiles
// staged in shared memory; workgroup z is the batch. TILE is chosen by the
// host so TILE * TILE fits maxComputeWorkGroupInvocations. Register blocking
// (several outputs per invocation) is the next step for speed.

#include "include/halves.glsl"

layout(constant_id = 0) const uint TILE = 16;
layout(constant_id = 1) const bool B_TRANSPOSED = false;
layout(constant_id = 2) const uint B_TYPE = TYPE_F32;
layout(local_size_x_id = 0, local_size_y_id = 0) in;

layout(std430, set = 0, binding = 0) readonly buffer A {
    float a[];
};
layout(std430, set = 0, binding = 1) readonly buffer B {
    float b[];
};
layout(std430, set = 0, binding = 1) readonly buffer BHalves {
    uint b_halves[];  // two 16-bit values per word
};
layout(std430, set = 0, binding = 2) writeonly buffer C {
    float c[];
};

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
    uint b_stride;  // elements between batches of b: K * N, or 0 when shared
    uint b_group;   // batches of a per batch of b
} params;

float load_b(uint i) {
    return B_TYPE == TYPE_F32 ? b[i] : half_element(b_halves[i / 2], i, B_TYPE);
}

shared float a_tile[TILE * TILE];  // [row][k]
shared float b_tile[TILE * TILE];  // [k][col]

void main() {
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint row = gl_WorkGroupID.y * TILE + ty;
    const uint col = gl_WorkGroupID.x * TILE + tx;
    const uint col0 = gl_WorkGroupID.x * TILE;

    const uint z = gl_WorkGroupID.z;
    const uint a_base = z * params.M * params.K;
    const uint b_base = (z / params.b_group) * params.b_stride;
    const uint c_base = z * params.M * params.N;

    float acc = 0.0;
    for (uint k0 = 0; k0 < params.K; k0 += TILE) {
        // Out-of-range loads become zeros, which add nothing to the sum.
        const uint ak = k0 + tx;
        a_tile[ty * TILE + tx] =
            (row < params.M && ak < params.K) ? a[a_base + row * params.K + ak] : 0.0;

        if (B_TRANSPOSED) {
            // b is [N, K]: let tx run along K so neighbouring invocations read
            // neighbouring addresses, and store transposed into [k][col].
            const uint n = col0 + ty;
            b_tile[tx * TILE + ty] =
                (n < params.N && ak < params.K) ? load_b(b_base + n * params.K + ak) : 0.0;
        } else {
            const uint bk = k0 + ty;
            b_tile[ty * TILE + tx] =
                (bk < params.K && col < params.N) ? load_b(b_base + bk * params.N + col) : 0.0;
        }
        barrier();

        for (uint p = 0; p < TILE; ++p) {
            acc += a_tile[ty * TILE + p] * b_tile[p * TILE + tx];
        }
        barrier();  // before the next iteration overwrites the tiles
    }

    if (row < params.M && col < params.N) {
        c[c_base + row * params.N + col] = acc;
    }
}
