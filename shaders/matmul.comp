#version 450
#extension GL_GOOGLE_include_directive : require

// c[z] = a[z] * b[z / b_group] for z in 0..batches, with a [M, K], c [M, N]
// and b either [K, N] or, when B_TRANSPOSED, [N, K]. Row-major; a and c are
// f32, b is f32, f16, bf16, Q8_0, Q4_0 or Q4_1 (B_TYPE, scales in binding 3), widened as
// it is loaded. With b_stride
// 0 every batch shares one b; b_group > 1 lets consecutive batches of a share
// one of b, as query heads share a KV head in grouped-query attention.
//
// A TILE x TILE workgroup computes a BM x BN block of c, each invocation a
// TM x TN sub-block kept in registers: reusing every loaded value TM or TN
// times is what makes this fast. The block steps through K by BK, with both
// input tiles staged in shared memory, stored k-major so the inner loop reads
// rows of them. An invocation's outputs are spread TILE apart rather than
// adjacent, so neighbouring invocations read neighbouring shared-memory words
// and write neighbouring addresses of c. Workgroup z is the batch.
//
// The host sets every size below and computes the dispatch from the same
// values (src/ops/matmul.cpp), keeping TILE * TILE within
// maxComputeWorkGroupInvocations and the tiles within shared memory.

#include "include/halves.glsl"

layout(constant_id = 0) const uint TILE = 16;
layout(constant_id = 1) const bool B_TRANSPOSED = false;
layout(constant_id = 2) const uint B_TYPE = TYPE_F32;
layout(constant_id = 3) const uint TM = 1;  // rows of c per invocation
layout(constant_id = 4) const uint TN = 4;  // columns of c per invocation
layout(constant_id = 5) const uint BK = 16;
layout(local_size_x_id = 0, local_size_y_id = 0) in;

const uint BM = TILE * TM;
const uint BN = TILE * TN;

layout(std430, set = 0, binding = 0) readonly buffer A {
    float a[];
};
layout(std430, set = 0, binding = 1) readonly buffer B {
    float b[];
};
layout(std430, set = 0, binding = 1) readonly buffer BHalves {
    uint b_halves[];  // two 16-bit values per word
};
layout(std430, set = 0, binding = 2) writeonly buffer C {
    float c[];
};
layout(std430, set = 0, binding = 3) readonly buffer BScales {
    float b_scales[];  // Q8_0 or Q4_0 block scales; bound to a dummy for other types
};
layout(std430, set = 0, binding = 3) readonly buffer BScaleHalves {
    uint b_scales_halves[];  // the same, as f16 (SCALE_TYPE)
};
layout(constant_id = 6) const uint SCALE_TYPE = TYPE_F32;  // the scales' type: f32 or f16

// Scale (or Q4_1 offset) i, widened from f16 by hand: subnormal scales,
// of blocks of tiny weights, must not flush to zero.
float b_scale(uint i) {
    return SCALE_TYPE == TYPE_F16 ? half_element(b_scales_halves[i / 2], i, TYPE_F16)
                                  : b_scales[i];
}

layout(push_constant) uniform Params {
    uint M;
    uint N;
    uint K;
    uint b_stride;  // elements between batches of b: K * N, or 0 when shared
    uint b_group;   // batches of a per batch of b
} params;

shared float a_tile[BK * BM];  // [k][row]
shared float b_tile[BK * BN];  // [k][col]

float load_b(uint i) {
    if (B_TYPE == TYPE_F32) return b[i];
    if (B_TYPE == TYPE_Q8) return q8_byte(b_halves[i / 4], i) * b_scale(i / Q8_BLOCK);
    if (B_TYPE == TYPE_Q4) return q4_nibble(b_halves[i / 8], i) * b_scale(i / Q4_BLOCK);
    if (B_TYPE == TYPE_Q4_1) {
        const uint block = i / Q4_BLOCK;
        return q4_code(b_halves[i / 8], i) * b_scale(2 * block) + b_scale(2 * block + 1);
    }
    return half_element(b_halves[i / 2], i, B_TYPE);
}

void main() {
    const uint tx = gl_LocalInvocationID.x;
    const uint ty = gl_LocalInvocationID.y;
    const uint tid = ty * TILE + tx;
    const uint threads = TILE * TILE;
    const uint row0 = gl_WorkGroupID.y * BM;
    const uint col0 = gl_WorkGroupID.x * BN;

    const uint z = gl_WorkGroupID.z;
    const uint a_base = z * params.M * params.K;
    const uint b_base = (z / params.b_group) * params.b_stride;
    const uint c_base = z * params.M * params.N;

    float acc[TM][TN];
    for (uint i = 0; i < TM; ++i) {
        for (uint j = 0; j < TN; ++j) acc[i][j] = 0.0;
    }

    for (uint k0 = 0; k0 < params.K; k0 += BK) {
        // Stage the tiles; out-of-range elements become zeros, which add
        // nothing. Consecutive invocations read consecutive addresses.
        for (uint e = tid; e < BM * BK; e += threads) {
            const uint r = e / BK, kk = e % BK;
            const uint row = row0 + r, k = k0 + kk;
            a_tile[kk * BM + r] = (row < params.M && k < params.K) ? a[a_base + row * params.K + k] : 0.0;
        }
        for (uint e = tid; e < BN * BK; e += threads) {
            uint col, kk;
            if (B_TRANSPOSED) {  // b is [N, K]: run along K
                col = e / BK;
                kk = e % BK;
            } else {  // b is [K, N]: run along N
                kk = e / BN;
                col = e % BN;
            }
            const uint n = col0 + col, k = k0 + kk;
            float v = 0.0;
            if (n < params.N && k < params.K) {
                v = load_b(b_base + (B_TRANSPOSED ? n * params.K + k : k * params.N + n));
            }
            b_tile[kk * BN + col] = v;
        }
        barrier();

        for (uint kk = 0; kk < BK; ++kk) {
            float av[TM], bv[TN];
            for (uint i = 0; i < TM; ++i) av[i] = a_tile[kk * BM + ty + i * TILE];
            for (uint j = 0; j < TN; ++j) bv[j] = b_tile[kk * BN + tx + j * TILE];
            for (uint i = 0; i < TM; ++i) {
                for (uint j = 0; j < TN; ++j) acc[i][j] += av[i] * bv[j];
            }
        }
        barrier();  // before the next iteration overwrites the tiles
    }

    for (uint i = 0; i < TM; ++i) {
        const uint row = row0 + ty + i * TILE;
        if (row >= params.M) continue;
        for (uint j = 0; j < TN; ++j) {
            const uint col = col0 + tx + j * TILE;
            if (col < params.N) c[c_base + row * params.N + col] = acc[i][j];
        }
    }
}
