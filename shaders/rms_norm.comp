#version 450

// out = x / sqrt(mean(x^2) + eps) * weight over each row of a [rows, cols]
// f32 matrix, with weight [cols]. One workgroup per row, as in softmax.comp.

layout(local_size_x_id = 0) in;

layout(std430, set = 0, binding = 0) readonly buffer X {
    float x[];
};
layout(std430, set = 0, binding = 1) readonly buffer W {
    float weight[];
};
layout(std430, set = 0, binding = 2) writeonly buffer Out {
    float out_[];
};

layout(push_constant) uniform Params {
    uint rows;
    uint cols;
    float eps;
} params;

shared float scratch[gl_WorkGroupSize.x];

float reduce_sum(float v) {
    const uint tid = gl_LocalInvocationID.x;
    scratch[tid] = v;
    barrier();
    for (uint n = gl_WorkGroupSize.x; n > 1;) {
        const uint half_ = (n + 1) / 2;
        if (tid < n - half_) scratch[tid] += scratch[tid + half_];
        barrier();
        n = half_;
    }
    const float r = scratch[0];
    barrier();  // before scratch is reused
    return r;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint width = gl_WorkGroupSize.x;

    for (uint row = gl_WorkGroupID.x; row < params.rows; row += gl_NumWorkGroups.x) {
        const uint base = row * params.cols;

        float sum_sq = 0.0;
        for (uint c = tid; c < params.cols; c += width) sum_sq += x[base + c] * x[base + c];
        sum_sq = reduce_sum(sum_sq);

        const float scale = inversesqrt(sum_sq / float(params.cols) + params.eps);
        for (uint c = tid; c < params.cols; c += width) {
            out_[base + c] = x[base + c] * scale * weight[c];
        }
    }
}
