#version 450

// Copies src [batches, rows, width] into dst [batches, capacity, width] at row
// start of every batch, for any 32-bit element type: appending new keys or
// values to a KV cache. Each batch of src is one contiguous block.

layout(local_size_x_id = 0) in;

layout(std430, set = 0, binding = 0) readonly buffer Src {
    uint src[];
};
layout(std430, set = 0, binding = 1) buffer Dst {
    uint dst[];
};

layout(push_constant) uniform Params {
    uint count;       // elements of src
    uint block;       // rows * width: elements per batch of src
    uint dst_stride;  // capacity * width: elements per batch of dst
    uint dst_start;   // start * width
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        const uint batch = i / params.block;
        dst[batch * params.dst_stride + params.dst_start + i % params.block] = src[i];
    }
}
