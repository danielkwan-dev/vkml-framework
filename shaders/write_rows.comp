#version 450

// Copies a block of rows of every batch between tensors of 32-bit elements:
// element i of the block, in batch i / block, is at src_start + i % block of
// that batch of src (src_stride elements per batch) and goes to dst_start +
// i % block of that batch of dst. Appending new keys or values to a KV cache
// writes rows into a longer dst; taking a range of queries reads rows out of
// a longer src.

layout(local_size_x_id = 0) in;

layout(std430, set = 0, binding = 0) readonly buffer Src {
    uint src[];
};
layout(std430, set = 0, binding = 1) buffer Dst {
    uint dst[];
};

layout(push_constant) uniform Params {
    uint count;       // elements copied
    uint block;       // rows * width: elements copied per batch
    uint src_stride;  // elements per batch of src
    uint src_start;   // first row * width, in src
    uint dst_stride;  // elements per batch of dst
    uint dst_start;   // first row * width, in dst
} params;

void main() {
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    for (uint i = gl_GlobalInvocationID.x; i < params.count; i += stride) {
        const uint batch = i / params.block, at = i % params.block;
        dst[batch * params.dst_stride + params.dst_start + at] =
            src[batch * params.src_stride + params.src_start + at];
    }
}
